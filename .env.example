# ==============================================================================
# TRUSTCART AI - ENVIRONMENT CONFIGURATION
# PayPal AI Hackathon 2026
# ==============================================================================

# Database Connection (SQLite local file by default, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# PayPal Developer Sandbox Credentials
# Get your Sandbox App Credentials at https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox" # "sandbox" | "live"
PAYPAL_WEBHOOK_ID=""

# AI Agent LLM Provider Configuration
# Optional: If unset, TrustCart AI utilizes its deterministic hybrid neural reasoning engine
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
